<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core 層の xUnit テスト。AutoCAD 参照を持たないため、AutoCAD 未インストールの
    環境(WSL 含む)で `dotnet test` がそのまま実行できる。

    内訳(docs/implementation-plan.md §10):
      007@b12b188 由来 8 ファイル / 103 ケース
      008@ff3a986 由来 4 ファイル / 172 ケース
      合計 275 ケース
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- CLAUDE.PRIVATE.md §2.1: using ディレクティブを使わない。 -->
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SheetPileQuayWall.Core\SheetPileQuayWall.Core.csproj" />
  </ItemGroup>

  <!--
    CatalogJsonTests は AppContext.BaseDirectory\data\ から読む(移植元 008 の実装のまま)。
    原本は fixtures\ に置き、出力先の data\ へリンクする。
  -->
  <ItemGroup>
    <None Include="fixtures\tairod_catalog_dimensions.json">
      <Link>data\tairod_catalog_dimensions.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
